{
  "name": "the-grey-area",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test lib/group/meeting-runtime.test.ts lib/group/stance-prompt.test.ts lib/case/story-arc.test.ts",
    "validate:cases": "tsx lib/case/validate.ts",
    "test:unit": "tsx --test app/simulation/decisions/three/avatar-motion.test.ts app/simulation/decisions/three/speech-pacing.test.ts app/simulation/decisions/three/rig-frame.test.ts lib/auth/policy.test.ts app/simulation/decisions/three/speech-playback.test.ts app/simulation/decisions/three/seated-arms.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env.local lib/db/seed.ts",
    "db:smoke": "tsx --env-file=.env.local lib/db/smoke.ts",
    "smoke:solo": "tsx --env-file=.env.local lib/db/solo-arc.smoke.ts",
    "smoke:group": "tsx --env-file=.env.local lib/db/group-arc.smoke.ts",
    "smoke:arcs": "npm run validate:cases && npm test && npm run smoke:solo && npm run smoke:group"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.12",
    "@ai-sdk/google": "^4.0.12",
    "@ai-sdk/openai": "^4.0.11",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.109.0",
    "ai": "^7.0.22",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.10",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.0",
    "three": "^0.186.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
