# App URL for join links — required for batch invites
NEXT_PUBLIC_APP_BASE_URL=

# Email (Resend) — SERVER ONLY
# RESEND_API_KEY and EMAIL_FROM are required to send invites.
# Sandbox from-address onboarding@resend.dev only delivers to your Resend
# account owner email. Verify a domain in Resend, then set EMAIL_FROM to it.
RESEND_API_KEY=
# Verified sender, e.g. The Cost of Winning <invites@yourdomain.com>
EMAIL_FROM=
# Optional: redirect every invite to this inbox for testing (intended recipient is logged)
EMAIL_TEST_TO=

# Supabase Postgres (Session pooler — use for Drizzle migrations, seed, server queries)
DATABASE_URL=

# Supabase project (safe in browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role — SERVER ONLY; never NEXT_PUBLIC_, never import in client components
SUPABASE_SERVICE_ROLE_KEY=

# Local instructor preview, only honored by next dev. Disabled in production.
DEV_IDENTITY=false

# Comma-separated verified Supabase Auth emails with full administrator access.
# Leave empty until the two owner accounts are provisioned.
ADMIN_EMAILS=

# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
